{
  "Search": {
    "Provider": "Meilisearch",
    "IndexName": "searchdocuments",
    "StaticIndexing": {
      "Enabled": false,
      "SeedOnStartup": false,
      "StartupSeedMaxAttempts": 5,
      "StartupSeedRetryDelaySeconds": 2
    },
    "IntegrationConsumer": {
      "Enabled": true,
      "QueueName": "netmetric.search.indexer",
      "RoutingKeyPatterns": ["search.index.*", "search.delete.*", "search.reindex.*"],
      "ProcessingFailureRequeueDelaySeconds": 0
    }
  },
  "Meilisearch": {
    "Endpoint": "http://localhost:7700",
    "ApiKey": "NETMETRIC_DEV_MEILI_MASTER_KEY_2026_0001"
  },
  "Messaging": {
    "RabbitMq": {
      "Uri": "amqp://guest:guest@localhost:5672/",
      "Exchange": "netmetric.search",
      "NetworkRecoveryIntervalSeconds": 10,
      "ConsumerDispatchConcurrency": 4,
      "PrefetchCount": 16
    }
  }
}
