{
  "AllowedHosts": "auth.netmetric.net;netmetric-auth-api",
  "ConnectionStrings": {
    "IdentityConnection": ""
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://+:8080"
      },
      "Https": {
        "Url": "https://+:8443"
      }
    }
  },
  "OpenApi": {
    "Title": "NetMetric Auth API",
    "Version": "v1"
  },
  "OpenTelemetry": {
    "Otlp": {
      "Endpoint": ""
    }
  },
  "Messaging": {
    "RabbitMq": {
      "Uri": "",
      "Exchange": "netmetric.integration",
      "NetworkRecoveryIntervalSeconds": 10,
      "ConsumerDispatchConcurrency": 4,
      "PrefetchCount": 16
    }
  },
  "Security": {
    "Cors": {
      "AllowedOrigins": [
        "https://netmetric.net",
        "https://www.netmetric.net",
        "https://auth.netmetric.net",
        "https://account.netmetric.net",
        "https://crm.netmetric.net",
        "https://tools.netmetric.net",
        "https://api.netmetric.net"
      ],
      "AllowCredentials": true
    },
    "ForwardedHeaders": {
      "ForwardLimit": 2,
      "KnownProxies": [],
      "KnownNetworks": ["10.0.0.0/8"]
    },
    "Headers": {
      "ContentSecurityPolicy": "default-src 'none'; frame-ancestors 'none'; frame-src 'none'; base-uri 'none'; object-src 'none'; form-action 'none';",
      "ReferrerPolicy": "no-referrer",
      "PermissionsPolicy": "camera=(), geolocation=(), microphone=()",
      "EnableHsts": true,
      "HstsMaxAgeSeconds": 31536000,
      "PreloadHsts": true,
      "IncludeSubDomains": true
    },
    "TenantResolution": {
      "RequireResolvedTenant": true,
      "AllowBodyFallback": false,
      "HeaderName": "X-Tenant-Id",
      "SlugHeaderName": "X-Tenant-Slug",
      "TrustedHostSuffixes": ["netmetric.net"],
      "TenantOptionalPathPrefixes": [
        "/api/auth/register",
        "/api/auth/login",
        "/api/auth/forgot-password",
        "/api/auth/reset-password",
        "/api/auth/confirm-email",
        "/api/auth/resend-confirm-email",
        "/api/auth/invitations/accept",
        "/api/auth/refresh",
        "/api/auth/logout",
        "/api/auth/confirm-email-change",
        "/api/auth/session-status"
      ]
    },
    "TokenTransport": {
      "Mode": "CookiesOnly",
      "AllowRefreshTokenFromRequestBody": false,
      "AllowSessionIdFromRequestBody": false,
      "AccessCookieName": "__Secure-netmetric-access",
      "RefreshCookieName": "__Secure-netmetric-refresh",
      "SessionCookieName": "__Secure-netmetric-session",
      "SameSite": "Lax",
      "AccessCookiePath": "/",
      "RefreshCookiePath": "/api/auth",
      "SessionCookiePath": "/api/auth",
      "CookieDomain": ".netmetric.net"
    },
    "TrustedGateway": {
      "RequireTrustedGateway": true,
      "Source": "NetMetric.ApiGateway",
      "AllowedSources": ["NetMetric.ApiGateway", "NetMetric.Account"],
      "CurrentKeyId": "gateway-prod-key-2026-01",
      "SignatureHeaderName": "X-Gateway-Signature",
      "TimestampHeaderName": "X-Gateway-Timestamp",
      "KeyIdHeaderName": "X-Gateway-Key-Id",
      "SourceHeaderName": "X-Gateway-Source",
      "NonceHeaderName": "X-Gateway-Request-Id",
      "ContentHashHeaderName": "X-Gateway-Content-SHA256",
      "AllowedClockSkewSeconds": 30,
      "ReplayProtectionWindowSeconds": 90,
      "AllowedGatewayProxies": [],
      "AllowedGatewayNetworks": ["10.0.0.0/8"],
      "Keys": [
        {
          "KeyId": "gateway-prod-key-2026-01",
          "Secret": "",
          "Enabled": true,
          "SignRequests": true
        },
        {
          "KeyId": "account-internal-prod-key-2026-01",
          "Secret": "",
          "Enabled": true,
          "SignRequests": false
        }
      ]
    },
    "InternalIdentity": {
      "AllowedSources": ["NetMetric.Account"]
    },
    "RateLimiting": {
      "Global": {
        "PermitLimit": 120,
        "WindowSeconds": 60,
        "QueueLimit": 0
      },
      "Login": {
        "PermitLimit": 5,
        "WindowSeconds": 60,
        "QueueLimit": 0
      },
      "Register": {
        "PermitLimit": 3,
        "WindowSeconds": 300,
        "QueueLimit": 0
      },
      "Refresh": {
        "PermitLimit": 10,
        "WindowSeconds": 60,
        "QueueLimit": 0
      },
      "Logout": {
        "PermitLimit": 20,
        "WindowSeconds": 60,
        "QueueLimit": 0
      },
      "Invite": {
        "PermitLimit": 10,
        "WindowSeconds": 300,
        "QueueLimit": 0
      },
      "RoleManagement": {
        "PermitLimit": 20,
        "WindowSeconds": 300,
        "QueueLimit": 0
      },
      "PasswordRecovery": {
        "PermitLimit": 3,
        "WindowSeconds": 300,
        "QueueLimit": 0
      },
      "EmailConfirmation": {
        "PermitLimit": 5,
        "WindowSeconds": 300,
        "QueueLimit": 0
      }
    },
    "Alerts": {
      "EnableStructuredAlerts": true
    },
    "TokenValidationCache": {
      "EnableCache": true,
      "AbsoluteExpirationSeconds": 30,
      "NegativeAbsoluteExpirationSeconds": 10,
      "KeyPrefix": "auth:user-token-state"
    }
  },
  "Jwt": {
    "Issuer": "https://auth.netmetric.net",
    "Audience": "https://app.netmetric.net",
    "AccessTokenMinutes": 15,
    "RefreshTokenHours": 8,
    "RefreshTokenPersistentDays": 14,
    "SigningKeys": [
      {
        "KeyId": "auth-rsa-prod-2026-01",
        "IsCurrent": true,
        "PrivateKeyPath": "/run/secrets/netmetric-auth-signing.pem",
        "PrivateKeyPem": ""
      }
    ]
  },
  "IdentitySecurity": {
    "MaxFailedAccessAttempts": 5,
    "LockoutMinutes": 15,
    "AllowedPublicTenantIds": []
  },
  "AccountLifecycle": {
    "RequireConfirmedEmailForLogin": true,
    "EmailConfirmationTokenMinutes": 1440,
    "PasswordResetTokenMinutes": 30,
    "EmailChangeTokenMinutes": 30,
    "InvitationTokenMinutes": 10080,
    "TokenBytes": 32,
    "PublicAppBaseUrl": "https://auth.netmetric.net",
    "ConfirmEmailPath": "/confirm-email",
    "ResetPasswordPath": "/reset-password",
    "ConfirmEmailChangePath": "/confirm-email-change"
  },
  "InvitationDelivery": {
    "AcceptBaseUrl": "https://auth.netmetric.net",
    "AcceptPath": "/invite/accept",
    "SenderName": "NetMetric",
    "SenderAddress": "no-reply@netmetric.net",
    "DisableDelivery": false,
    "Provider": "notification",
    "SmtpHost": "",
    "SmtpPort": 587,
    "SmtpUseStartTls": true,
    "SmtpUserName": null,
    "SmtpPassword": null,
    "ResendThrottleSeconds": 300,
    "MaxResends": 5
  },
  "PasswordPolicy": {
    "MinimumLength": 12,
    "MaxLength": 128,
    "RequiredUniqueChars": 4,
    "RequireUppercase": true,
    "RequireLowercase": true,
    "RequireDigit": true,
    "RequireNonAlphanumeric": true,
    "DisallowWhitespace": true,
    "BlacklistedPasswords": ["Password123!", "Qwerty123!", "Admin123!", "12345678"]
  },
  "Seed": {
    "DefaultTenantId": "11111111-1111-1111-1111-111111111111",
    "AllowStartupSeed": false,
    "AllowProductionStartupSeed": false
  },
  "Database": {
    "ApplyMigrationsOnStartup": false
  },
  "Authorization": {
    "DefaultRoles": ["tenant-user"],
    "DefaultPermissions": ["session:self", "profile:self"],
    "Policies": [
      {
        "Name": "session:self",
        "RequiredPermissions": ["session:self"],
        "RequiredRoles": [],
        "RequireAuthenticatedUser": true,
        "RequireTenantClaim": true
      },
      {
        "Name": "tenant.users.invite",
        "RequiredPermissions": ["tenant.users.invite"],
        "RequiredRoles": [],
        "RequireAuthenticatedUser": true,
        "RequireTenantClaim": true
      },
      {
        "Name": "tenant.roles.read",
        "RequiredPermissions": ["roles.read"],
        "RequiredRoles": [],
        "RequireAuthenticatedUser": true,
        "RequireTenantClaim": true
      },
      {
        "Name": "tenant.roles.manage",
        "RequiredPermissions": ["roles.manage"],
        "RequiredRoles": [],
        "RequireAuthenticatedUser": true,
        "RequireTenantClaim": true
      }
    ]
  },
  "SessionSecurity": {
    "MaxActiveSessions": 5,
    "IdleTimeoutMinutes": 1440,
    "AbsoluteLifetimeDays": 14
  },
  "DataRetention": {
    "EnableCleanupService": true,
    "CleanupIntervalMinutes": 60,
    "AuditRetentionDays": 90,
    "RevokedSessionRetentionDays": 30
  },
  "Infrastructure": {
    "DistributedCache": {
      "Provider": "Redis",
      "RedisConnectionString": "",
      "InstanceName": "NetMetric:Auth:",
      "ConnectTimeoutMilliseconds": 5000,
      "AsyncTimeoutMilliseconds": 5000,
      "SyncTimeoutMilliseconds": 5000,
      "ConnectRetry": 3,
      "AbortOnConnectFail": false,
      "RequireExternalProviderInProduction": true
    },
    "DataProtection": {
      "ApplicationName": "NetMetric.Auth",
      "KeyRingPath": "/var/lib/netmetric/auth/dataprotection",
      "RequirePersistentKeyRingInProduction": true
    }
  }
}
